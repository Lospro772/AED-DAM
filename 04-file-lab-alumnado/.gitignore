# Python (calcular_nota.py y cachés)
# ==========================================
__pycache__/
*.py[cod]
.pytest_cache/

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ==========================================
# Datos temporales / de trabajo del laboratorio
