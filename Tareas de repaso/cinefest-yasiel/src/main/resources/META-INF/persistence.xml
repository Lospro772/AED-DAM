<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
 <persistence-unit name="cinefestPU" transaction-type="RESOURCE_LOCAL">
  <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
  <class>es.ejemplo.cinefest.orm.entity.SedeEntity</class>
  <class>es.ejemplo.cinefest.orm.entity.SalaEntity</class>
  <class>es.ejemplo.cinefest.orm.entity.PeliculaEntity</class>
  <class>es.ejemplo.cinefest.orm.entity.SesionEntity</class>
  <class>es.ejemplo.cinefest.orm.entity.EspectadorEntity</class>
  <class>es.ejemplo.cinefest.orm.entity.EntradaEntity</class>
  <class>es.ejemplo.cinefest.orm.entity.ValoracionEntity</class>
  <properties>
   <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
   <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
   <property name="hibernate.hbm2ddl.auto" value="none"/>
   <property name="hibernate.show_sql" value="false"/>
  </properties>
 </persistence-unit>
</persistence>
